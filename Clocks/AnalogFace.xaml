<UserControl x:Class="GoogleDesktopRemake.Clocks.AnalogFace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="120" Height="120">
    <Grid>
        <Ellipse x:Name="Bezel" Width="116" Height="116" Stroke="#99000000" StrokeThickness="1">
            <Ellipse.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0.6,1">
                    <GradientStop Color="#FFFAFAFA" Offset="0"/>
                    <GradientStop Color="#FF9A9A9A" Offset="0.5"/>
                    <GradientStop Color="#FFE2E2E2" Offset="1"/>
                </LinearGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.6"/></Ellipse.Effect>
        </Ellipse>
        <Ellipse x:Name="Dial" Width="104" Height="104" Stroke="#66000000" StrokeThickness="1">
            <Ellipse.Fill>
                <RadialGradientBrush GradientOrigin="0.4,0.3">
                    <GradientStop Color="#FFFFFFFF" Offset="0"/>
                    <GradientStop Color="#FFE8E8E8" Offset="0.7"/>
                    <GradientStop Color="#FFBFBFBF" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Canvas x:Name="Ticks" Width="104" Height="104"/>
        <TextBlock x:Name="Label" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Margin="0,46,0,0" FontSize="9" Foreground="#FF6A6A6A" FontFamily="Segoe UI"/>
        <Canvas Width="120" Height="120">
            <Line x:Name="HourHand" X1="60" Y1="62" X2="60" Y2="36" Stroke="#FF1E1E1E" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                <Line.RenderTransform><RotateTransform x:Name="HourRot" CenterX="60" CenterY="60"/></Line.RenderTransform>
                <Line.Effect><DropShadowEffect BlurRadius="3" ShadowDepth="1.5" Opacity="0.4"/></Line.Effect>
            </Line>
            <Line x:Name="MinHand" X1="60" Y1="62" X2="60" Y2="20" Stroke="#FF2A2A2A" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                <Line.RenderTransform><RotateTransform x:Name="MinRot" CenterX="60" CenterY="60"/></Line.RenderTransform>
                <Line.Effect><DropShadowEffect BlurRadius="3" ShadowDepth="1.5" Opacity="0.4"/></Line.Effect>
            </Line>
            <Line X1="60" Y1="70" X2="60" Y2="16" Stroke="#FFD42020" StrokeThickness="1.2">
                <Line.RenderTransform><RotateTransform x:Name="SecRot" CenterX="60" CenterY="60"/></Line.RenderTransform>
            </Line>
            <Ellipse Canvas.Left="55" Canvas.Top="55" Width="10" Height="10" Fill="#FFD42020" Stroke="#FF700000"/>
        </Canvas>
        <Ellipse x:Name="Gloss" Width="96" Height="50" VerticalAlignment="Top" Margin="0,8,0,0" IsHitTestVisible="False">
            <Ellipse.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#99FFFFFF" Offset="0"/>
                    <GradientStop Color="#05FFFFFF" Offset="1"/>
                </LinearGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
    </Grid>
</UserControl>
