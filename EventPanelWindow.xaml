<Window x:Class="GoogleDesktopRemake.EventPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calendar events" Width="300" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" WindowStartupLocation="Manual"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border Margin="12" CornerRadius="8" BorderThickness="1" BorderBrush="#CCFFFFFF" Padding="10,8,10,10"
            Background="{DynamicResource WindowGlass}">
        <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.6"/></Border.Effect>
        <StackPanel>
            <DockPanel Margin="2,0,2,6" Background="Transparent" MouseLeftButtonDown="Title_Drag">
                <Button DockPanel.Dock="Right" Content="×" Style="{StaticResource GlassButton}" Click="Close_Click"/>
                <TextBlock x:Name="DateText" Foreground="White" FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center">
                    <TextBlock.Effect><DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.7"/></TextBlock.Effect>
                </TextBlock>
            </DockPanel>

            <Border Background="#FFF1F5FA" CornerRadius="4" Padding="10" BorderThickness="1" BorderBrush="#99000000">
                <StackPanel>
                    <TextBlock Text="On this day" FontWeight="SemiBold" Foreground="#FF35516F"/>
                    <ItemsControl x:Name="DayList" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="0,3" BorderThickness="0,0,0,1" BorderBrush="#22000000">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="×" Width="18" Height="18" Padding="0" Margin="6,0,0,0"
                                                ToolTip="Delete event" Click="Delete_Click" Cursor="Hand"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding WhenText}" FontSize="11" Foreground="#FF2E6E9E"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="NoEvents" Text="Nothing planned." Foreground="#FF7A8794" FontStyle="Italic" Margin="0,4,0,0"/>

                    <Separator Margin="0,10,0,8"/>

                    <TextBlock Text="New event" FontWeight="SemiBold" Foreground="#FF35516F" Margin="0,0,0,4"/>
                    <CheckBox x:Name="AllDayCheck" Content="All-day event" IsChecked="True"
                              Checked="AllDay_Changed" Unchecked="AllDay_Changed"/>

                    <Grid x:Name="TimeRow" Visibility="Collapsed" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="From " VerticalAlignment="Center"/>
                        <ComboBox x:Name="FromBox" Grid.Column="1" IsEditable="True" Height="24" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="2" Text="To " VerticalAlignment="Center"/>
                        <ComboBox x:Name="ToBox" Grid.Column="3" IsEditable="True" Height="24"/>
                    </Grid>

                    <TextBlock Text="What kind of event?" Margin="0,8,0,2"/>
                    <TextBox x:Name="TitleBox" Height="24" VerticalContentAlignment="Center" KeyDown="TitleBox_KeyDown"/>
                    <TextBlock x:Name="ErrorText" Foreground="#FFC62828" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>

                    <Button Content="Add event" Style="{StaticResource AeroButton}" HorizontalAlignment="Right"
                            Margin="0,8,0,0" Click="Add_Click"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
