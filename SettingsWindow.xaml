<Window x:Class="GoogleDesktopRemake.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:GoogleDesktopRemake.Controls"
        Title="Google Desktop Settings" Width="540" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True">
    <Border Margin="14" CornerRadius="8" BorderThickness="1" BorderBrush="#CCFFFFFF" Padding="8,6,8,10"
            Background="{DynamicResource WindowGlass}">
        <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.6"/></Border.Effect>

        <StackPanel>
            <DockPanel Margin="4,0,4,6" Background="Transparent" MouseLeftButtonDown="TitleBar_Drag">
                <Button DockPanel.Dock="Right" Content="×" Style="{StaticResource GlassButton}" Click="Close_Click"/>
                <c:GoogleLogo FontSize="15" VerticalAlignment="Center"/>
                <TextBlock Text="  Desktop Settings" Foreground="White" FontFamily="Segoe UI" FontSize="14" VerticalAlignment="Center">
                    <TextBlock.Effect><DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.7"/></TextBlock.Effect>
                </TextBlock>
            </DockPanel>

            <Border Background="#FFF1F5FA" CornerRadius="4" Padding="8" BorderThickness="1" BorderBrush="#99000000">
                <StackPanel>
                    <TabControl x:Name="Tabs" Height="410">

                        <!-- ============ SIDEBAR ============ -->
                        <TabItem Header="Sidebar">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="8">
                                    <GroupBox Header="Color theme" Padding="8" Margin="0,0,0,8">
                                        <StackPanel>
                                            <ComboBox x:Name="ThemeBox" Height="24" SelectionChanged="Theme_Changed">
                                                <ComboBoxItem Tag="Aero" Content="Aero blue (default)"/>
                                                <ComboBoxItem Tag="Dark" Content="Dark - black glass, black clock"/>
                                                <ComboBoxItem Tag="Custom" Content="Custom color..."/>
                                            </ComboBox>

                                            <StackPanel x:Name="CustomPanel" Visibility="Collapsed" Margin="0,8,0,0">
                                                <WrapPanel x:Name="Swatches"/>
                                                <DockPanel Margin="0,6,0,0"><TextBlock Text="R" Width="16" VerticalAlignment="Center"/>
                                                    <Slider x:Name="RSlider" Minimum="0" Maximum="255" ValueChanged="Rgb_Changed"/></DockPanel>
                                                <DockPanel><TextBlock Text="G" Width="16" VerticalAlignment="Center"/>
                                                    <Slider x:Name="GSlider" Minimum="0" Maximum="255" ValueChanged="Rgb_Changed"/></DockPanel>
                                                <DockPanel><TextBlock Text="B" Width="16" VerticalAlignment="Center"/>
                                                    <Slider x:Name="BSlider" Minimum="0" Maximum="255" ValueChanged="Rgb_Changed"/></DockPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                    <TextBlock Text="Hex " VerticalAlignment="Center"/>
                                                    <TextBox x:Name="HexBox" Width="80" Height="24" VerticalContentAlignment="Center" TextChanged="Hex_Changed"/>
                                                    <Border x:Name="Preview" Width="44" Height="22" Margin="10,0,0,0" CornerRadius="3"
                                                            BorderBrush="#FF555555" BorderThickness="1"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </GroupBox>

                                    <GroupBox Header="Behavior" Padding="8">
                                        <StackPanel>
                                            <CheckBox x:Name="TopmostCheck" Content="Keep sidebar on top of other windows (off = stays on the desktop)" Margin="0,0,0,4"/>
                                            <CheckBox x:Name="MoveIconsCheck" Content="Move desktop files and folders out from under the sidebar" Margin="0,0,0,4"/>
                                            <CheckBox x:Name="RestoreIconsCheck" Content="Put them back when the sidebar closes" Margin="18,0,0,0"/>
                                            <CheckBox x:Name="DoubleCtrlSearchCheck" Content="Open Quick Search when Ctrl is pressed twice" Margin="0,4,0,0"/>
                                            <Button x:Name="StartupButton" Content="Add to startup programs" Style="{StaticResource AeroButton}"
                                                    HorizontalAlignment="Left" Margin="0,8,0,0" Click="Startup_Click"/>
                                            <TextBlock x:Name="StartupStatus" FontSize="11" Foreground="#FF667788" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            <Button Content="Reset all app data..." Style="{StaticResource AeroButton}"
                                                    HorizontalAlignment="Left" Margin="0,10,0,0" Click="ResetAppData_Click"/>
                                            <TextBlock Text="Deletes saved settings, calendar events, and sticky notes for this Windows account. The app closes; next launch shows first-run setup. Startup registration is unchanged."
                                                       FontSize="11" Foreground="#FF667788" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </GroupBox>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- ============ BACKGROUND ============ -->
                        <TabItem Header="Background">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="8">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <Border Width="72" Height="190" CornerRadius="4" BorderBrush="#FF555555" BorderThickness="1" ClipToBounds="True">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#FF7A8FA8" Offset="0"/>
                                                        <GradientStop Color="#FFE8C49A" Offset="0.5"/>
                                                        <GradientStop Color="#FF5B7A5A" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Grid Background="Transparent">
                                                    <Grid x:Name="BackgroundPreviewLayer">
                                                        <Border x:Name="BgPreview"/>
                                                        <c:AeroStreaks x:Name="PreviewStreaks" Visibility="Collapsed"/>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="Preview over a sample wallpaper" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="90" FontSize="10" Foreground="#FF667788" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                            <TextBlock Text="Preset" FontWeight="SemiBold" Foreground="#FF35516F"/>
                                            <ComboBox x:Name="PresetBox" Height="24" Margin="0,3,0,10" SelectionChanged="Preset_Changed"/>
                                            <TextBlock Text="Style" FontWeight="SemiBold" Foreground="#FF35516F"/>
                                            <ComboBox x:Name="BgStyleBox" Height="24" Margin="0,3,0,0" SelectionChanged="BgStyle_Changed">
                                                <ComboBoxItem Tag="Theme" Content="Glass - follows the color theme"/>
                                                <ComboBoxItem Tag="Gradient" Content="Custom gradient (your own colors)"/>
                                            </ComboBox>
                                            <TextBlock Text="Presets fill in the gradient and streaks below; tweak anything afterwards, then press Apply."
                                                       FontSize="11" Foreground="#FF667788" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <GroupBox Header="Transparency (applies to every style)" Padding="8" Margin="0,0,0,8">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock x:Name="OpacityText" DockPanel.Dock="Right" Width="40" TextAlignment="Right"/>
                                                <Slider x:Name="OpacitySlider" Minimum="5" Maximum="100" ValueChanged="Opacity_Changed"/>
                                            </DockPanel>
                                            <TextBlock Text="Left = see-through, right = solid" FontSize="11" Foreground="#FF667788"/>
                                        </StackPanel>
                                    </GroupBox>

                                    <StackPanel x:Name="GradientPanel" Visibility="Collapsed">
                                        <GroupBox Header="Direction and position" Padding="8" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                <TextBlock Text="Direction" VerticalAlignment="Center"/>
                                                <Slider x:Name="AngleSlider" Grid.Column="1" Minimum="0" Maximum="360" ValueChanged="Bg_Changed"/>
                                                <TextBlock x:Name="AngleText" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Row="1" Text="Position" VerticalAlignment="Center"/>
                                                <Slider x:Name="ShiftSlider" Grid.Row="1" Grid.Column="1" Minimum="-50" Maximum="50" ValueChanged="Bg_Changed"/>
                                                <TextBlock x:Name="ShiftText" Grid.Row="1" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Row="2" Grid.ColumnSpan="3" FontSize="11" Foreground="#FF667788" Margin="0,4,0,0" TextWrapping="Wrap"
                                                           Text="Direction 0° = left to right, 90° = top to bottom. Position slides the whole gradient along that direction."/>
                                            </Grid>
                                        </GroupBox>
                                        <GroupBox Header="Gradient colors" Padding="8" Margin="0,0,0,8">
                                            <StackPanel>
                                                <StackPanel x:Name="StopsPanel"/>
                                                <Button x:Name="AddStopButton" Content="Add a color" Style="{StaticResource AeroButton}"
                                                        HorizontalAlignment="Left" Click="AddStop_Click"/>
                                                <TextBlock Text="Up to 6 colors. Click a swatch to pick one or type a hex code; the slider moves that color along the gradient."
                                                           FontSize="11" Foreground="#FF667788" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </GroupBox>
                                    </StackPanel>

                                    <GroupBox Header="Windows 7 light streaks" Padding="8">
                                        <StackPanel>
                                            <CheckBox x:Name="StreaksCheck" Content="Add soft curved light streaks and glows" Checked="Bg_Changed" Unchecked="Bg_Changed"/>
                                            <DockPanel Margin="0,6,0,0">
                                                <TextBlock x:Name="StreakText" DockPanel.Dock="Right" Width="44" TextAlignment="Right"/>
                                                <TextBlock DockPanel.Dock="Left" Text="Strength" Width="70" VerticalAlignment="Center"/>
                                                <Slider x:Name="StreakSlider" Minimum="10" Maximum="100" ValueChanged="Bg_Changed"/>
                                            </DockPanel>
                                            <TextBlock Text="Works with any style, including the default glass." FontSize="11" Foreground="#FF667788" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </GroupBox>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- ============ CLOCK ============ -->
                        <TabItem Header="Clock">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="8">
                                    <GroupBox Header="Clock style" Padding="8" Margin="0,0,0,8">
                                        <StackPanel>
                                            <ComboBox x:Name="ClockStyleBox" Height="24">
                                                <ComboBoxItem Tag="Analog" Content="Analog - silver (black in Dark theme)"/>
                                                <ComboBoxItem Tag="AnalogBlack" Content="Analog - black"/>
                                                <ComboBoxItem Tag="Flip" Content="Flip clock - wood grain frame"/>
                                                <ComboBoxItem Tag="Segment" Content="Red segment display - black plastic"/>
                                            </ComboBox>
                                            <TextBlock Text="Only the analog clocks show seconds." FontSize="11" Foreground="#FF667788" Margin="0,4,0,0"/>
                                            <CheckBox x:Name="Hour24Check" Content="24-hour time (digital clocks)" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </GroupBox>

                                    <GroupBox Header="Time" Padding="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/><ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Text="Time source" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="SourceBox" Grid.Column="1" Height="24" Margin="0,0,0,6" SelectionChanged="Source_Changed">
                                                <ComboBoxItem Tag="System" Content="This PC's clock"/>
                                                <ComboBoxItem Tag="NTP" Content="Internet time (NTP server)"/>
                                            </ComboBox>

                                            <TextBlock Grid.Row="1" Text="Server" VerticalAlignment="Center"/>
                                            <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,6">
                                                <Button x:Name="SyncBtn" DockPanel.Dock="Right" Content="Sync now" Style="{StaticResource AeroButton}" Margin="6,0,0,0" Click="Sync_Click"/>
                                                <TextBox x:Name="NtpBox" Height="24" VerticalContentAlignment="Center"/>
                                            </DockPanel>

                                            <TextBlock Grid.Row="2" Text="Time zone" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="ZoneBox" Grid.Row="2" Grid.Column="1" Height="24" Margin="0,0,0,6" DisplayMemberPath="Display"/>

                                            <TextBlock Grid.Row="3" Text="Label" VerticalAlignment="Center"/>
                                            <TextBox x:Name="LabelBox" Grid.Row="3" Grid.Column="1" Height="24" VerticalContentAlignment="Center" Margin="0,0,0,4"/>

                                            <TextBlock x:Name="SyncStatus" Grid.Row="4" Grid.ColumnSpan="2" Foreground="#FF555555" FontSize="11" TextWrapping="Wrap"/>
                                        </Grid>
                                    </GroupBox>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- ============ GADGETS ============ -->
                        <TabItem x:Name="GadgetsTab" Header="Gadgets">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="8">
                                    <GroupBox Header="Show / hide gadgets" Padding="8" Margin="0,0,0,8">
                                        <StackPanel>
                                            <CheckBox x:Name="PhotosCheck" Content="Photo frame" Margin="0,0,0,4" Checked="Widget_Changed" Unchecked="Widget_Changed"/>
                                            <CheckBox x:Name="NewsCheck" Content="News feed" Margin="0,0,0,4" Checked="Widget_Changed" Unchecked="Widget_Changed"/>
                                            <CheckBox x:Name="CalendarCheck" Content="Calendar (click a day to add events)" Margin="0,0,0,4" Checked="Widget_Changed" Unchecked="Widget_Changed"/>
                                            <CheckBox x:Name="NotesCheck" Content="Sticky notes" Margin="0,0,0,4" Checked="Widget_Changed" Unchecked="Widget_Changed"/>
                                            <CheckBox x:Name="CalculatorCheck" Content="Calculator" Checked="Widget_Changed" Unchecked="Widget_Changed"/>
                                            <TextBlock x:Name="WidgetSpaceError" Foreground="#FFB00020" FontWeight="SemiBold" FontSize="11"
                                                       TextWrapping="Wrap" Margin="0,6,0,0"/>
                                            <TextBlock Text="The calendar, notes and calculator take space from the news feed." FontSize="11"
                                                       Foreground="#FF667788" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </GroupBox>
                                    <GroupBox Header="Photo folder" Padding="8">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Browse..." Style="{StaticResource AeroButton}" Margin="6,0,0,0" Click="Browse_Click"/>
                                            <TextBox x:Name="FolderBox" Height="24" VerticalContentAlignment="Center"/>
                                        </DockPanel>
                                    </GroupBox>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- ============ WEATHER ============ -->
                        <TabItem Header="Weather">
                            <StackPanel Margin="8">
                                <GroupBox Header="Location" Padding="8">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Search" Style="{StaticResource AeroButton}" Margin="6,0,0,0" Click="PlaceSearch_Click"/>
                                            <TextBox x:Name="PlaceBox" Height="24" VerticalContentAlignment="Center" KeyDown="PlaceBox_KeyDown"/>
                                        </DockPanel>
                                        <ListBox x:Name="PlaceResults" Visibility="Collapsed" MaxHeight="120" Margin="0,6,0,0"
                                                 DisplayMemberPath="Display" SelectionChanged="PlaceResults_Selected"/>
                                        <TextBlock x:Name="CurrentPlace" Margin="0,6,0,0" Foreground="#FF2E5E2E" FontWeight="SemiBold"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <RadioButton x:Name="FahrenheitRadio" Content="°F" Margin="0,0,14,0"/>
                                            <RadioButton x:Name="CelsiusRadio" Content="°C"/>
                                        </StackPanel>
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </TabItem>

                        <!-- ============ NEWS ============ -->
                        <TabItem Header="News">
                            <StackPanel Margin="8">
                                <GroupBox Header="RSS / Atom feeds (all are merged, newest first)" Padding="8">
                                    <StackPanel>
                                        <ListBox x:Name="FeedList" Height="130" DisplayMemberPath="Name" SelectionChanged="FeedList_Selected"/>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60"/><ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Name" VerticalAlignment="Center"/>
                                            <TextBox x:Name="FeedNameBox" Grid.Column="1" Height="24" VerticalContentAlignment="Center" Margin="0,0,0,6"/>
                                            <TextBlock Grid.Row="1" Text="URL" VerticalAlignment="Center"/>
                                            <TextBox x:Name="FeedUrlBox" Grid.Row="1" Grid.Column="1" Height="24" VerticalContentAlignment="Center"/>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                            <Button Content="Add" Style="{StaticResource AeroButton}" Margin="0,0,6,0" Click="FeedAdd_Click"/>
                                            <Button Content="Update" Style="{StaticResource AeroButton}" Margin="0,0,6,0" Click="FeedUpdate_Click"/>
                                            <Button Content="Remove" Style="{StaticResource AeroButton}" Click="FeedRemove_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </TabItem>
                    </TabControl>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="Apply" Style="{StaticResource AeroButton}" Margin="0,0,6,0" IsDefault="True" Click="Apply_Click"/>
                        <Button Content="Close" Style="{StaticResource AeroButton}" IsCancel="True" Click="Close_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
