<UserControl x:Class="GoogleDesktopRemake.Controls.AeroStreaks"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False">
    <Viewbox Stretch="Fill">
        <Canvas x:Name="Art" Width="200" Height="800" ClipToBounds="True">
            <Ellipse Canvas.Left="-90" Canvas.Top="540" Width="380" Height="330" Fill="{DynamicResource AeroBloom}"/>
            <Ellipse Canvas.Left="-20" Canvas.Top="-150" Width="340" Height="360" Fill="{DynamicResource AeroHaze}"/>
            <Ellipse Canvas.Left="38" Canvas.Top="372" Width="140" Height="44" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform><RotateTransform Angle="-34"/></Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#50FFFFFF" Offset="0"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>
    </Viewbox>
</UserControl>
