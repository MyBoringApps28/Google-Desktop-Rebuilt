<UserControl x:Class="GoogleDesktopRemake.Controls.GoogleLogo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Georgia" FontWeight="Bold" FontSize="14" Cursor="Hand" ToolTip="Open google.com">
    <TextBlock Background="Transparent">
        <TextBlock.Effect><DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.6"/></TextBlock.Effect>
        <Run Foreground="#FF6FA2F5" Text="G"/><Run Foreground="#FFEF6F5E" Text="o"/><Run Foreground="#FFF7D54A" Text="o"/><Run Foreground="#FF6FA2F5" Text="g"/><Run Foreground="#FF7CD05A" Text="l"/><Run Foreground="#FFEF6F5E" Text="e"/>
    </TextBlock>
</UserControl>
