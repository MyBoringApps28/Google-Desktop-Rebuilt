<Window x:Class="GoogleDesktopRemake.SidebarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:g="clr-namespace:GoogleDesktopRemake.Gadgets"
        xmlns:c="clr-namespace:GoogleDesktopRemake.Controls"
        Title="Google Desktop" Width="200" Height="800"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="Manual" Background="Transparent">
    <Grid>
        <Grid x:Name="BackgroundLayer" IsHitTestVisible="False">
            <!-- blue glass tint over the blurred wallpaper -->
            <Border Background="{DynamicResource SidebarTint}" BorderThickness="1,0,0,0"
                    BorderBrush="{StaticResource GlassEdge}"/>
            <c:AeroStreaks x:Name="StreaksBox" Visibility="Collapsed"/>
            <!-- diagonal Aero light streak -->
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.6">
                        <GradientStop Color="#38FFFFFF" Offset="0"/>
                        <GradientStop Color="#00FFFFFF" Offset="0.5"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <Grid x:Name="ContentGrid" Margin="12,8,12,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- 0 title -->
                <RowDefinition Height="Auto"/>   <!-- 1 clock -->
                <RowDefinition Height="Auto"/>   <!-- 2 weather -->
                <RowDefinition Height="Auto"/>   <!-- 3 photo -->
                <RowDefinition Height="Auto"/>   <!-- 4 calendar (optional) -->
                <RowDefinition Height="Auto"/>   <!-- 5 sticky notes (optional) -->
                <RowDefinition Height="Auto"/>   <!-- 6 calculator (optional) -->
                <RowDefinition x:Name="NewsRow" Height="*" MinHeight="70"/>   <!-- 7 news -->
                <RowDefinition Height="Auto"/>   <!-- 8 search -->
            </Grid.RowDefinitions>

            <!-- title row -->
            <DockPanel Grid.Row="0" Margin="0,0,0,4">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="&#x2699;" FontFamily="Segoe UI Symbol" Style="{StaticResource GlassButton}" Margin="0,0,4,0"
                            ToolTip="Settings" Click="Settings_Click"/>
                    <Button Content="+" Style="{StaticResource GlassButton}" Margin="0,0,4,0"
                            ToolTip="Quick Search" Click="OpenSearch_Click"/>
                    <Button Content="×" Style="{StaticResource GlassButton}"
                            ToolTip="Close sidebar" Click="Close_Click"/>
                </StackPanel>
                <c:GoogleLogo HorizontalAlignment="Left" FontSize="13"/>
            </DockPanel>

            <g:ClockGadget Grid.Row="1" HorizontalAlignment="Center" Margin="0,2,0,6"/>
            <g:WeatherGadget Grid.Row="2" Margin="0,0,0,8"/>
            <g:PhotoGadget x:Name="PhotoBox" Grid.Row="3" Margin="0,0,0,10"/>
            <g:CalendarGadget x:Name="CalendarBox" Grid.Row="4" Margin="0,0,0,10" Visibility="Collapsed"/>
            <g:NotesGadget x:Name="NotesBox" Grid.Row="5" Margin="0,0,0,10" Visibility="Collapsed"
                           FloatRequested="NotesBox_FloatRequested"/>
            <g:CalculatorGadget x:Name="CalcBox" Grid.Row="6" Margin="0,0,0,10" Visibility="Collapsed"/>
            <g:NewsGadget x:Name="NewsBox" Grid.Row="7" Margin="0,0,0,10"/>

            <!-- search gadget -->
            <Border Grid.Row="8" CornerRadius="4" BorderThickness="1" Padding="8,6,8,8"
                    Background="{StaticResource DarkGlass}" BorderBrush="{StaticResource GlassEdge}">
                <StackPanel>
                    <c:GoogleLogo HorizontalAlignment="Left" FontSize="13" Margin="0,0,0,4"/>
                    <Border CornerRadius="3" BorderThickness="2" BorderBrush="#FFF2C230" Padding="0">
                        <TextBox x:Name="SearchBox" Style="{StaticResource AeroTextBox}" Height="22"
                                 Padding="3,0" FontSize="12" KeyDown="SearchBox_KeyDown"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
