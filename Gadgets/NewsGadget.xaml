<UserControl x:Class="GoogleDesktopRemake.Gadgets.NewsGadget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="ArrowButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Body" CornerRadius="8" BorderThickness="1" BorderBrush="#E6FFFFFF"
                                    Background="{DynamicResource ButtonGlass}">
                                <Border.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.6"/></Border.Effect>
                            </Border>
                            <Border CornerRadius="7,7,3,3" Margin="2,1,2,0" Height="6" VerticalAlignment="Top"
                                    Background="{StaticResource GlossHighlight}" IsHitTestVisible="False"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border x:Name="Hover" CornerRadius="8" Background="#40FFFFFF" Opacity="0" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Body" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border CornerRadius="4" BorderThickness="1" Background="{StaticResource DarkGlass}" ClipToBounds="True"
            BorderBrush="{StaticResource GlassEdge}">
        <Grid>
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Hidden">
                <ItemsControl x:Name="Items">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="6,5" BorderThickness="0,0,0,1" BorderBrush="#33FFFFFF"
                                    Cursor="Hand" MouseLeftButtonUp="Item_Click">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#22FFFFFF"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Foreground="White" FontSize="11"
                                               FontFamily="Segoe UI" TextWrapping="Wrap" MaxHeight="48"/>
                                    <DockPanel Margin="0,2,0,0">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Age}" Foreground="{StaticResource AeroGreen}"
                                                   FontSize="10" FontFamily="Segoe UI"/>
                                        <TextBlock Text="{Binding Source}" Foreground="{StaticResource AeroCyan}"
                                                   FontSize="10" FontFamily="Segoe UI"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <!-- glossy upper half -->
            <Rectangle Height="26" VerticalAlignment="Top" IsHitTestVisible="False" Fill="{StaticResource GlossHighlight}" Opacity="0.25"/>

            <Button x:Name="UpArrow" Style="{StaticResource ArrowButton}" VerticalAlignment="Top" HorizontalAlignment="Center"
                    Margin="0,3,0,0" Visibility="Collapsed" ToolTip="Scroll up" Click="Up_Click">
                <Path Data="M0,5 L5,0 L10,5 Z" Fill="White" Stretch="Uniform" Width="10" Height="6"/>
            </Button>
            <Button x:Name="DownArrow" Style="{StaticResource ArrowButton}" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                    Margin="0,0,0,3" Visibility="Collapsed" ToolTip="Scroll down" Click="Down_Click">
                <Path Data="M0,0 L10,0 L5,5 Z" Fill="White" Stretch="Uniform" Width="10" Height="6"/>
            </Button>
        </Grid>
    </Border>
</UserControl>
