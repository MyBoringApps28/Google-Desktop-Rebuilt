<UserControl x:Class="GoogleDesktopRemake.Gadgets.CalendarGadget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border CornerRadius="5" BorderThickness="1" BorderBrush="{StaticResource GlassEdge}" ClipToBounds="True"
            Background="{DynamicResource PanelGlass}">
        <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="3" Opacity="0.55"/></Border.Effect>
        <Grid>
            <Rectangle Height="40" VerticalAlignment="Top" IsHitTestVisible="False"
                       Fill="{StaticResource GlossHighlight}" Opacity="0.35"/>
            <StackPanel>
                <!-- what's coming up -->
                <StackPanel x:Name="Upcoming" Margin="8,6,8,0"/>

                <DockPanel Margin="6,4,6,2" Height="20">
                    <Button DockPanel.Dock="Left" Content="‹" Width="16" Height="16" Style="{StaticResource GlassButton}" Click="Prev_Click"/>
                    <Button DockPanel.Dock="Right" Content="›" Width="16" Height="16" Style="{StaticResource GlassButton}" Click="Next_Click"/>
                    <TextBlock x:Name="MonthText" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="White" FontWeight="SemiBold" FontSize="11" FontFamily="Segoe UI"
                               Cursor="Hand" ToolTip="Back to this month" MouseLeftButtonUp="Month_Click"/>
                </DockPanel>

                <UniformGrid x:Name="Days" Rows="7" Columns="7" Height="126" Margin="6,0,6,6"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
