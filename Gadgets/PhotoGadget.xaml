<UserControl x:Class="GoogleDesktopRemake.Gadgets.PhotoGadget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="112">
    <Grid>
        <Border CornerRadius="3" BorderThickness="2" Background="#FF0A2A4A" ClipToBounds="True">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFFFFFFF" Offset="0"/>
                    <GradientStop Color="#FF4A6A8A" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="3" Opacity="0.6"/></Border.Effect>
            <Grid>
                <Image x:Name="Back" Stretch="UniformToFill"/>
                <Image x:Name="Front" Stretch="UniformToFill"/>
                <!-- diagonal glass sheen -->
                <Rectangle IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#40FFFFFF" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="0.45"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </Grid>
        </Border>
    </Grid>
</UserControl>
