<UserControl x:Class="GoogleDesktopRemake.Gadgets.CalculatorGadget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="CalcButton" TargetType="Button">
            <Setter Property="Height" Value="21"/>
            <Setter Property="Margin" Value="1.5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd" CornerRadius="4" BorderThickness="1" BorderBrush="#AA000000"
                                    Background="{TemplateBinding Background}"/>
                            <Border CornerRadius="3,3,8,8" Margin="1,1,1,0" Height="9" VerticalAlignment="Top"
                                    IsHitTestVisible="False" Background="{StaticResource GlossHighlight}" Opacity="0.75"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Effect">
                                            <Setter.Value><DropShadowEffect BlurRadius="2" ShadowDepth="1" Opacity="0.6"/></Setter.Value>
                                        </Setter>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                            <Border x:Name="Hover" CornerRadius="4" Background="#33FFFFFF" Opacity="0" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border CornerRadius="5" BorderThickness="1" Padding="5,6,5,4" BorderBrush="{StaticResource GlassEdge}"
            Background="{StaticResource DarkGlass}">
        <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="3" Opacity="0.55"/></Border.Effect>
        <StackPanel>
            <Border CornerRadius="3" BorderThickness="1" BorderBrush="#99000000" Padding="6,2,6,1" Margin="1.5,0,1.5,4">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFD2DEC2" Offset="0"/>
                        <GradientStop Color="#FFA9BA95" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel>
                    <TextBlock x:Name="ExprText" FontSize="9" FontFamily="Segoe UI" Foreground="#FF4A5A3A"
                               HorizontalAlignment="Right" Height="12" TextTrimming="CharacterEllipsis"/>
                    <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Right" Height="24">
                        <TextBlock x:Name="DisplayText" Text="0" FontSize="20" FontFamily="Consolas" Foreground="#FF1E2A14"/>
                    </Viewbox>
                </StackPanel>
            </Border>

            <UniformGrid x:Name="Keys" Columns="4"/>
            <Button x:Name="FractionKey" Style="{StaticResource CalcButton}" Margin="1.5,1.5,1.5,1.5"
                    Content="a⁄b   fraction ⇄ decimal" FontSize="11" ToolTip="Show the result as a fraction (press again for the decimal)"
                    Tag="FRAC"/>
        </StackPanel>
    </Border>
</UserControl>
