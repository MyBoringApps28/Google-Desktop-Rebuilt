<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Frutiger Aero palette -->
    <LinearGradientBrush x:Key="SidebarTint" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#B012416D" Offset="0"/>
        <GradientStop Color="#8C1C6BAA" Offset="0.55"/>
        <GradientStop Color="#663C91CA" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="DarkGlass" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E61A2430" Offset="0"/>
        <GradientStop Color="#F2090E16" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlossHighlight" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#99FFFFFF" Offset="0"/>
        <GradientStop Color="#14FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassEdge" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#CCFFFFFF" Offset="0"/>
        <GradientStop Color="#33FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="AeroCyan" Color="#FF5FE0FF"/>
    <SolidColorBrush x:Key="AeroGreen" Color="#FF8BE04A"/>

    <RadialGradientBrush x:Key="AeroBloom">
        <GradientStop Color="#9970D8FF" Offset="0"/><GradientStop Color="#0070D8FF" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="AeroHaze">
        <GradientStop Color="#709A9AE8" Offset="0"/><GradientStop Color="#009A9AE8" Offset="1"/>
    </RadialGradientBrush>

    <!-- Theme brushes: defaults here, replaced at runtime by ThemeManager -->
    <LinearGradientBrush x:Key="ButtonGlass" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF66B2EE" Offset="0"/><GradientStop Color="#FF0E4C94" Offset="0.5"/><GradientStop Color="#FF3794E0" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PanelGlass" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#D04A74C4" Offset="0"/><GradientStop Color="#D01F3E80" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="WindowGlass" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#F0A9CBEE" Offset="0"/><GradientStop Color="#F05C8FC6" Offset="0.5"/><GradientStop Color="#F03A6FAE" Offset="1"/>
    </LinearGradientBrush>

    <!-- Glossy round button (the + and x on the sidebar) -->
    <Style x:Key="GlassButton" TargetType="Button">
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse Stroke="#D0FFFFFF" StrokeThickness="1" Fill="{DynamicResource ButtonGlass}"/>
                        <Ellipse x:Name="Gloss" Margin="2,1,2,0" Height="8" VerticalAlignment="Top"
                                 Fill="{StaticResource GlossHighlight}"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="0,-1,0,0" TextElement.FontWeight="Bold" TextElement.FontSize="12"/>
                        <Ellipse x:Name="Hover" Fill="#55A8E8FF" Opacity="0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Gloss" Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Inset search field -->
    <Style x:Key="AeroTextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="#FF202020"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border CornerRadius="3" Background="White" BorderThickness="1" Padding="{TemplateBinding Padding}">
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FF4A4A4A" Offset="0"/>
                                <GradientStop Color="#FFC8C8C8" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                            <Rectangle Height="3" VerticalAlignment="Top" IsHitTestVisible="False">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#33000000" Offset="0"/>
                                        <GradientStop Color="#00000000" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Classic Aero push button (Settings window) -->
    <Style x:Key="AeroButton" TargetType="Button">
        <Setter Property="Foreground" Value="#FF1E1E1E"/>
        <Setter Property="Padding" Value="12,3"/>
        <Setter Property="MinWidth" Value="72"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="3" BorderThickness="1" BorderBrush="#FF707070" Padding="{TemplateBinding Padding}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FFF6F6F6" Offset="0"/>
                                <GradientStop Color="#FFEAEAEA" Offset="0.5"/>
                                <GradientStop Color="#FFDCDCDC" Offset="0.5"/>
                                <GradientStop Color="#FFCDCDCD" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#FF3C7FB1"/>
                            <Setter TargetName="Bd" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFEAF6FD" Offset="0"/>
                                        <GradientStop Color="#FFD9F0FC" Offset="0.5"/>
                                        <GradientStop Color="#FFBEE6FD" Offset="0.5"/>
                                        <GradientStop Color="#FFA7D9F5" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#FF2C628B"/>
                            <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
